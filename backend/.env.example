# Server Configuration
SERVER_PORT=3009

# Database Configuration
# Format: postgres://username:password@host/database
DATABASE_URL=postgres://username:password@localhost/database_name

# JWT Configuration
JWT_SECRET_KEY=fixtures/private_key.pem
JWT_PUBLIC_KEY=fixtures/public_key.pem
JWT_DURATION=86400
JWT_REFRESH_DURATION=604800
JWT_ISSUER=my_service
JWT_AUDIENCE=my_app

# CORS Configuration
CORS_ORIGIN=http://localhost:51994

# Logging (optional)
# RUST_LOG=info
