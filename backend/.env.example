# Server Configuration
SERVER_PORT=3009

# Database Configuration
# Format: postgres://username:password@host/database
DATABASE_URL=postgres://mac:123456@localhost/example

# JWT Configuration
JWT_SECRET_KEY=fixtures/private_key.pem
JWT_PUBLIC_KEY=fixtures/public_key.pem
JWT_DURATION=86400
JWT_REFRESH_DURATION=604800
JWT_ISSUER=my_service
JWT_AUDIENCE=my_app

# CORS Configuration
CORS_ORIGIN=http://localhost:51994
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=content-type,authorization,x-requested-with,accept,x-user-agent

# Logging (optional)
# RUST_LOG=info
